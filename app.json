{
  "expo": {
    "name": "Yahtzee!",
    "slug": "yahtzee-mobile",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "yahtzee",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.iainhoolahan.yahtzee",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.iainhoolahan.yahtzee",
      "adaptiveIcon": {
        "backgroundColor": "#080B0C",
        "foregroundImage": "./assets/yahtzee-dice-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f301eab8-f15b-45bc-95f3-003588b54842"
      }
    },
    "owner": "iainhoolahan",
    "plugins": [
      "expo-font",
      "expo-notifications"
    ]
  }
}
